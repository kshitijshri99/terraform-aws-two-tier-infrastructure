aws_region = "eu-north-1"

project_name = "terraform-two-tier"

environment = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "eu-north-1a",
  "eu-north-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_web_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

private_db_subnet_cidrs = [
  "10.0.21.0/24",
  "10.0.22.0/24"
]

instance_type = "t3.micro"

desired_capacity = 2
min_size         = 2
max_size         = 4

db_name           = "twotierdb"
db_username       = "admin"
db_password       = "ReplaceWithYourPassword"
db_instance_class = "db.t3.micro"
allocated_storage = 20
engine_version    = "8.4.5"

health_check_path = "/"