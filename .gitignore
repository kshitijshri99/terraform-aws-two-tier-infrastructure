#################################################
# Terraform
#################################################

# Local Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variable files (contains secrets)
terraform.tfvars
*.auto.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
*.plan

#################################################
# Sensitive Files
#################################################

# Environment variables
.env
.env.*

#################################################
# IDE Files
#################################################

# Visual Studio Code
.vscode/

# IntelliJ IDEA
.idea/

#################################################
# Operating System Files
#################################################

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

#################################################
# Logs
#################################################

*.log

#################################################
# Keep Terraform Lock File
#################################################

!.terraform.lock.hcl